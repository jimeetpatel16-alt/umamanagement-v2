# Always check for the newest app files (cheap: unchanged files return 304),
# so phones pick up updates straight after a deploy.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/styles.css
  Cache-Control: no-cache
/excel.js
  Cache-Control: no-cache
/vendor/*
  Cache-Control: public, max-age=604800
